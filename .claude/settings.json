{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Write(clients/**)",
      "Edit(clients/**)",
      "Write(core/**)",
      "Edit(core/**)",
      "Write(modules/**)",
      "Edit(modules/**)",
      "Write(.claude/agents/**)",
      "Edit(.claude/agents/**)",
      "Write(.claude/commands/**)",
      "Edit(.claude/commands/**)",
      "Write(docs/**)",
      "Edit(docs/**)",
      "Bash(python core/scripts/crawl.py:*)",
      "Bash(python core/scripts/gsc.py:*)",
      "Bash(python modules/seo/scripts/pagespeed.py:*)",
      "Bash(cp -r clients/_template:*)",
      "Bash(mkdir -p clients/:*)",
      "Bash(mv clients/:*)"
    ],
    "deny": [
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(rm:*)",
      "Write(.claude/settings.json)",
      "Edit(.claude/settings.json)"
    ]
  }
}
