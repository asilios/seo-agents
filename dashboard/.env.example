# Репозиторий с данными системы
GITHUB_REPO=asilios/seo-agents
GITHUB_BRANCH=master

# Вход через GitHub: OAuth App (github.com → Settings → Developer settings → OAuth Apps)
# Callback URL: https://<адрес-на-railway>/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# кому можно входить, через запятую
ALLOWED_GITHUB_USERS=asilios,kemalshen
# случайная строка ≥32 символов: openssl rand -base64 48
AUTH_SECRET=

# Только для разработки: читать файлы с диска без входа (в production игнорируется)
# DATA_SOURCE=local
# LOCAL_REPO_PATH=..
